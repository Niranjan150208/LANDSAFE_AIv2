PORT=3000
# Long random string used to sign login tokens. CHANGE THIS.
JWT_SECRET=change-me-to-a-long-random-string
# Optional: real SMS through Twilio. Leave empty to run in dry-run mode (SMS is logged and stored only).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Optional: path for the SQLite file
DB_PATH=./landsafe.db
